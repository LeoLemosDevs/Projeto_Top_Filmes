# ==========================================
# TOP FILMES - VARIÁVEIS DE AMBIENTE
# ==========================================

# 1. Banco de Dados Turso (libSQL na nuvem)
# Crie seu banco grátis em https://turso.tech
# Se deixar em branco, o sistema utilizará banco local SQLite automático (topfilmes.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 2. Segredo para tokens de autenticação JWT
JWT_SECRET=top_filmes_super_segredo_jwt_2026_xyz_producao

# 3. Credenciais Padrão do Administrador (criadas no seed inicial se não existirem)
ADMIN_INITIAL_EMAIL=professorleolemos@gmail.com
ADMIN_INITIAL_PASSWORD=leo250778

# 4. URL Base da Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. Serviço de Envio de E-mail (Confirmação de Conta e Recuperação de Senha)
# Exemplo com Gmail (requer criar uma "Senha de App" na conta Google):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=professorleolemos@gmail.com
SMTP_PASS=sua_senha_de_app_google
SMTP_FROM="Top Filmes" <professorleolemos@gmail.com>

# Dica: Em desenvolvimento local, se deixar as variáveis SMTP em branco,
# o sistema simula o envio e gera o link direto no terminal e na tela para testes rápidos!
